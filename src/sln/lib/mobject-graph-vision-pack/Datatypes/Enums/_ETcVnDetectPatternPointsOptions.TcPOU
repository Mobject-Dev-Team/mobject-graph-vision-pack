    <Method Name="Clone" Id="{32b381f9-086b-451d-bb9e-587e2fadffaa}" FolderPath="Customize\">
      <Declaration><![CDATA[METHOD PUBLIC Clone : I_Datatype
VAR
    pClone : POINTER TO _ETcVnDetectPatternPointsOptions;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[pClone := __NEW(_ETcVnDetectPatternPointsOptions(InitialValue := Value));
IF pClone = 0 THEN
    RETURN;
END_IF
Clone := pClone^;]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_init" Id="{e4fd6b37-f9f9-4974-86a6-7f29a2cde7c3}" FolderPath="Customize\Constructor\">
      <Declaration><![CDATA[METHOD FB_init : BOOL
VAR_INPUT
	bInitRetains : BOOL; // if TRUE, the retain variables are initialized (warm start / cold start)
	bInCopyCode : BOOL;  // if TRUE, the instance afterwards gets moved into the copy code (online change)
	InitialValue : ETcVnDetectPatternPointsOptions;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[localData := InitialValue;
AddBaseDatatype(enumBaseDatatype);
ClearReference();

AddLocalEnumeration('TCVN_DPPO_SYMMETRIC', ETcVnDetectPatternPointsOptions.TCVN_DPPO_SYMMETRIC);
AddLocalEnumeration('TCVN_DPPO_ASYMMETRIC', ETcVnDetectPatternPointsOptions.TCVN_DPPO_ASYMMETRIC);
AddLocalEnumeration('TCVN_DPPO_CLUSTERING', ETcVnDetectPatternPointsOptions.TCVN_DPPO_CLUSTERING);
]]></ST>
      </Implementation>
    </Method>
