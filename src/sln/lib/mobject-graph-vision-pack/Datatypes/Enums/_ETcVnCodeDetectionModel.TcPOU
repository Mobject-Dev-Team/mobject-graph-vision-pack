    <Method Name="FB_init" Id="{4b3cc9dd-10e0-0f24-3e56-a36e90fdd84a}" FolderPath="Customize\Constructor\">
      <Declaration><![CDATA[METHOD FB_init : BOOL
VAR_INPUT
	bInitRetains : BOOL; // if TRUE, the retain variables are initialized (warm start / cold start)
	bInCopyCode : BOOL;  // if TRUE, the instance afterwards gets moved into the copy code (online change)
	InitialValue : ETcVnCodeDetectionModel;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[localData := InitialValue;
AddBaseDatatype(enumBaseDatatype);
ClearReference();

AddLocalEnumeration('TCVN_CDM_DETECT_1_1', ETcVnCodeDetectionModel.TCVN_CDM_DETECT_1_1);
AddLocalEnumeration('TCVN_CDM_DETECT_1_2', ETcVnCodeDetectionModel.TCVN_CDM_DETECT_1_2);
AddLocalEnumeration('TCVN_CDM_DETECT_1_3', ETcVnCodeDetectionModel.TCVN_CDM_DETECT_1_3);
AddLocalEnumeration('TCVN_CDM_DETECT_2_1', ETcVnCodeDetectionModel.TCVN_CDM_DETECT_2_1);
AddLocalEnumeration('TCVN_CDM_DETECT_2_2', ETcVnCodeDetectionModel.TCVN_CDM_DETECT_2_2);
AddLocalEnumeration('TCVN_CDM_DETECT_2_3', ETcVnCodeDetectionModel.TCVN_CDM_DETECT_2_3);
AddLocalEnumeration('TCVN_CDM_DETECT_3_1', ETcVnCodeDetectionModel.TCVN_CDM_DETECT_3_1);
AddLocalEnumeration('TCVN_CDM_DETECT_3_2', ETcVnCodeDetectionModel.TCVN_CDM_DETECT_3_2);
AddLocalEnumeration('TCVN_CDM_DETECT_3_3', ETcVnCodeDetectionModel.TCVN_CDM_DETECT_3_3);]]></ST>
      </Implementation>
    </Method>
