    <Declaration><![CDATA[{attribute 'linkalways'} 
{attribute 'no_explicit_call' := 'This FB is a CLASS and must be accessed using methods or properties'}
{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK _ETcVnCodeDetectionModel EXTENDS EnumDatatypeBase
VAR
	localData : ETcVnCodeDetectionModel;
	activeData : REFERENCE TO ETcVnCodeDetectionModel;
	enumBaseDatatype : _ULINT(localData);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
