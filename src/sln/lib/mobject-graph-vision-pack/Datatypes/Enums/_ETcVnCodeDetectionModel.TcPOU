    <Method Name="ClearReference" Id="{78abd788-dbf9-08b7-0fbc-bb4212861b25}" FolderPath="Core\">
      <Declaration><![CDATA[METHOD PUBLIC ClearReference
VAR_INPUT
END_VAR
]]></Declaration>
