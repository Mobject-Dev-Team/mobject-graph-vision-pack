    <Method Name="IsEnumeratorValueEqual" Id="{baf9f37e-9a41-4d84-a1fd-fce9b6d7824d}" FolderPath="Customize\Protected\">
      <Declaration><![CDATA[METHOD IsEnumeratorValueEqual : BOOL
