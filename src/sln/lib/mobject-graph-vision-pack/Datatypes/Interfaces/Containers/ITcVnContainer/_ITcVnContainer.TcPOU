		Serialize_ContainerType_Vector_TcVnPoint3_REAL(Serializer, container);
	ELSE
		Serializer.AddNull();
	END_IF
	
END_FOR

IF container <> 0 THEN
	container.TcRelease();
END_IF

Serializer.EndArray();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Serialize_ContainerType_Vector_Vector_UDINT" Id="{fcbfc8a3-ec09-0941-02f3-a117d3833e64}" FolderPath="Customize\Private\">
      <Declaration><![CDATA[METHOD PRIVATE Serialize_ContainerType_Vector_Vector_UDINT
VAR_INPUT
	Serializer : I_Serializer;
	TargetContainer : ITcVnContainer;
END_VAR
VAR
	hr : HRESULT;
	container : ITcVnContainer;
	elementCount : ULINT;
	i : ULINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TargetContainer.GetElementNum(elementCount);
Serializer.StartArray();

FOR i := 0 TO elementCount - 1 DO 
	
	hr := F_VN_GetAt_ITcVnContainer(TargetContainer, container, i, S_OK);
	
	IF SUCCEEDED(hr) THEN
		Serialize_ContainerType_Vector_UDINT(Serializer, container);
	ELSE
		Serializer.AddNull();
	END_IF
	
END_FOR

IF container <> 0 THEN
	container.TcRelease();
END_IF

Serializer.EndArray();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Serialize_ContainerType_Vector_Vector_ULINT" Id="{62b728fb-1e78-09d8-12d8-67044837c6d6}" FolderPath="Customize\Private\">
      <Declaration><![CDATA[METHOD PRIVATE Serialize_ContainerType_Vector_Vector_ULINT
VAR_INPUT
	Serializer : I_Serializer;
	TargetContainer : ITcVnContainer;
END_VAR
VAR
	hr : HRESULT;
	container : ITcVnContainer;
	elementCount : ULINT;
	i : ULINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TargetContainer.GetElementNum(elementCount);
Serializer.StartArray();

FOR i := 0 TO elementCount - 1 DO 
	
	hr := F_VN_GetAt_ITcVnContainer(TargetContainer, container, i, S_OK);
	
	IF SUCCEEDED(hr) THEN
		Serialize_ContainerType_Vector_ULINT(Serializer, container);
	ELSE
		Serializer.AddNull();
	END_IF
	
END_FOR

IF container <> 0 THEN
	container.TcRelease();
END_IF

Serializer.EndArray();]]></ST>
      </Implementation>
    </Method>
    <Method Name="SerializeWith" Id="{8c39171b-b6bc-0e1b-005c-9497fee68eef}" FolderPath="Customize\">
      <Declaration><![CDATA[METHOD PUBLIC SerializeWith
VAR_INPUT
	Serializer : I_Serializer;
END_VAR
VAR
	containerTypeName : _STRING('');
	containerTypeGuid : _GUID;
	elementTypeGuid : _GUID;
    elementNum : _ULINT(0);
    elementSize : _ULINT(0);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT (activeData <> 0) THEN
	Serializer.AddNull();
	RETURN;
END_IF

activeData.GetTypeName(containerTypeName.Value,UDINT_TO_UINT(containerTypeName.Size));
activeData.GetTypeGuid(containerTypeGuid.Value);
activeData.GetElementTypeGuid(elementTypeGuid.Value);
activeData.GetElementNum(elementNum.Value);
activeData.GetElementSize(elementSize.Value);

Serializer.StartObject();
Serializer.AddKeyObject('containerTypeName', containerTypeName);
Serializer.AddKeyString('containerTypeGuid', containerTypeGuid.ToString());
Serializer.AddKeyString('elementTypeGuid', elementTypeGuid.ToString());
Serializer.AddKeyObject('elementNum', elementNum);
Serializer.AddKeyObject('elementSize', elementSize);
Serializer.AddKey('elements');
// Serializer.StartArray();

IF containerTypeName.Value = 'CTcVnContainer_Vector_SINT' THEN
	Serialize_ContainerType_Vector_SINT(Serializer, activeData);		
ELSIF containerTypeName.Value = 'CTcVnContainer_Vector_USINT' THEN
	Serialize_ContainerType_Vector_USINT(Serializer, activeData);
ELSIF containerTypeName.Value = 'CTcVnContainer_Vector_INT' THEN
	Serialize_ContainerType_Vector_INT(Serializer, activeData);
ELSIF containerTypeName.Value = 'CTcVnContainer_Vector_UINT' THEN
	Serialize_ContainerType_Vector_UINT(Serializer, activeData);
ELSIF containerTypeName.Value = 'CTcVnContainer_Vector_DINT' THEN
	Serialize_ContainerType_Vector_DINT(Serializer, activeData);
ELSIF containerTypeName.Value = 'CTcVnContainer_Vector_UDINT' THEN
	Serialize_ContainerType_Vector_UDINT(Serializer, activeData);
ELSIF containerTypeName.Value = 'CTcVnContainer_Vector_ULINT' THEN
	Serialize_ContainerType_Vector_ULINT(Serializer, activeData);
ELSIF containerTypeName.Value = 'CTcVnContainer_Vector_REAL' THEN
	Serialize_ContainerType_Vector_REAL(Serializer, activeData);
ELSIF containerTypeName.Value = 'CTcVnContainer_Vector_LREAL' THEN
	Serialize_ContainerType_Vector_LREAL(Serializer, activeData);
ELSIF containerTypeName.Value = 'CTcVnContainer_Vector_ITcVnImage' THEN
	Serialize_ContainerType_Vector_ITcVnImage(Serializer, activeData);
	
//Vector_TcVnPoint2
ELSIF containerTypeName.Value = 'CTcVnContainer_Vector_TcVnPoint2_DINT' THEN
	Serialize_ContainerType_Vector_TcVnPoint2_DINT(Serializer, activeData);
ELSIF containerTypeName.Value = 'CTcVnContainer_Vector_TcVnPoint2_REAL' THEN
	Serialize_ContainerType_Vector_TcVnPoint2_REAL(Serializer, activeData);
ELSIF containerTypeName.Value = 'CTcVnContainer_Vector_TcVnPoint2_LREAL' THEN
	Serialize_ContainerType_Vector_TcVnPoint2_LREAL(Serializer, activeData);
	
//Vector_TcVnPoint3
ELSIF containerTypeName.Value = 'CTcVnContainer_Vector_TcVnPoint3_REAL' THEN
	Serialize_ContainerType_Vector_TcVnPoint3_REAL(Serializer, activeData);
ELSIF containerTypeName.Value = 'CTcVnContainer_Vector_TcVnPoint3_LREAL' THEN
	Serialize_ContainerType_Vector_TcVnPoint3_LREAL(Serializer, activeData);
	
//Vector_TcVnVector2
ELSIF containerTypeName.Value = 'CTcVnContainer_Vector_TcVnVector2_SINT' THEN
	Serialize_ContainerType_Vector_TcVnVector2_SINT(Serializer, activeData);
ELSIF containerTypeName.Value = 'CTcVnContainer_Vector_TcVnVector2_USINT' THEN
	Serialize_ContainerType_Vector_TcVnVector2_USINT(Serializer, activeData);
ELSIF containerTypeName.Value = 'CTcVnContainer_Vector_TcVnVector2_INT' THEN
	Serialize_ContainerType_Vector_TcVnVector2_INT(Serializer, activeData);
ELSIF containerTypeName.Value = 'CTcVnContainer_Vector_TcVnVector2_UINT' THEN
	Serialize_ContainerType_Vector_TcVnVector2_UINT(Serializer, activeData);
ELSIF containerTypeName.Value = 'CTcVnContainer_Vector_TcVnVector2_DINT' THEN
	Serialize_ContainerType_Vector_TcVnVector2_DINT(Serializer, activeData);
ELSIF containerTypeName.Value = 'CTcVnContainer_Vector_TcVnVector2_REAL' THEN
	Serialize_ContainerType_Vector_TcVnVector2_REAL(Serializer, activeData);
	
//Vector_TcVnVector3
ELSIF containerTypeName.Value = 'CTcVnContainer_Vector_TcVnVector3_SINT' THEN
	Serialize_ContainerType_Vector_TcVnVector3_SINT(Serializer, activeData);
ELSIF containerTypeName.Value = 'CTcVnContainer_Vector_TcVnVector3_USINT' THEN
	Serialize_ContainerType_Vector_TcVnVector3_USINT(Serializer, activeData);
ELSIF containerTypeName.Value = 'CTcVnContainer_Vector_TcVnVector3_INT' THEN
	Serialize_ContainerType_Vector_TcVnVector3_INT(Serializer, activeData);
ELSIF containerTypeName.Value = 'CTcVnContainer_Vector_TcVnVector3_UINT' THEN
	Serialize_ContainerType_Vector_TcVnVector3_UINT(Serializer, activeData);
ELSIF containerTypeName.Value = 'CTcVnContainer_Vector_TcVnVector3_REAL' THEN
	Serialize_ContainerType_Vector_TcVnVector3_REAL(Serializer, activeData);
	
//Vector_TcVnVector4
ELSIF containerTypeName.Value = 'CTcVnContainer_Vector_TcVnVector4_SINT' THEN
	Serialize_ContainerType_Vector_TcVnVector4_SINT(Serializer, activeData);
ELSIF containerTypeName.Value = 'CTcVnContainer_Vector_TcVnVector4_USINT' THEN
	Serialize_ContainerType_Vector_TcVnVector4_USINT(Serializer, activeData);
ELSIF containerTypeName.Value = 'CTcVnContainer_Vector_TcVnVector4_INT' THEN
	Serialize_ContainerType_Vector_TcVnVector4_INT(Serializer, activeData);
ELSIF containerTypeName.Value = 'CTcVnContainer_Vector_TcVnVector4_UINT' THEN
	Serialize_ContainerType_Vector_TcVnVector4_UINT(Serializer, activeData);
ELSIF containerTypeName.Value = 'CTcVnContainer_Vector_TcVnVector4_DINT' THEN
	Serialize_ContainerType_Vector_TcVnVector4_DINT(Serializer, activeData);
ELSIF containerTypeName.Value = 'CTcVnContainer_Vector_TcVnVector4_REAL' THEN
	Serialize_ContainerType_Vector_TcVnVector4_REAL(Serializer, activeData);
ELSIF containerTypeName.Value = 'CTcVnContainer_Vector_TcVnVector4_LREAL' THEN
	Serialize_ContainerType_Vector_TcVnVector4_LREAL(Serializer, activeData);
	
//Vector_Vector
ELSIF containerTypeName.Value = 'CTcVnContainer_Vector_Vector_DINT' THEN
	Serialize_ContainerType_Vector_Vector_DINT(Serializer, activeData);
ELSIF containerTypeName.Value = 'CTcVnContainer_Vector_Vector_UDINT' THEN
	Serialize_ContainerType_Vector_Vector_UDINT(Serializer, activeData);
ELSIF containerTypeName.Value = 'CTcVnContainer_Vector_Vector_ULINT' THEN
	Serialize_ContainerType_Vector_Vector_ULINT(Serializer, activeData);
ELSIF containerTypeName.Value = 'CTcVnContainer_Vector_Vector_REAL' THEN
	Serialize_ContainerType_Vector_Vector_REAL(Serializer, activeData);
ELSIF containerTypeName.Value = 'CTcVnContainer_Vector_Vector_LREAL' THEN
	Serialize_ContainerType_Vector_Vector_LREAL(Serializer, activeData);
	
//Vector_Vector_TcVnPoint2
ELSIF containerTypeName.Value = 'CTcVnContainer_Vector_Vector_TcVnPoint2_DINT' THEN
	Serialize_ContainerType_Vector_Vector_TcVnPoint2_DINT(Serializer, activeData);	
ELSIF containerTypeName.Value = 'CTcVnContainer_Vector_Vector_TcVnPoint2_REAL' THEN
	Serialize_ContainerType_Vector_Vector_TcVnPoint2_REAL(Serializer, activeData);
	
//Vector_Vector_TcVnPoint3	
ELSIF containerTypeName.Value = 'CTcVnContainer_Vector_Vector_TcVnPoint3_REAL' THEN
	Serialize_ContainerType_Vector_Vector_TcVnPoint3_REAL(Serializer, activeData);
	
//Other
ELSIF containerTypeName.Value = 'CTcVnContainer_Vector_TcVnRectangle_DINT' THEN
	Serialize_ContainerType_Vector_TcVnRectangle_DINT(Serializer, activeData);
ELSIF containerTypeName.Value = 'CTcVnContainer_Vector_TcVnRotatedRectangle' THEN
	Serialize_ContainerType_Vector_TcVnRotatedRectangle(Serializer, activeData);
ELSIF containerTypeName.Value = 'CTcVnContainer_Vector_TcVnKeyPoint' THEN
	Serialize_ContainerType_Vector_TcVnKeyPoint(Serializer, activeData);
ELSIF containerTypeName.Value = 'CTcVnContainer_Vector_TcVnDMatch' THEN
	Serialize_ContainerType_Vector_TcVnDMatch(Serializer, activeData);
ELSIF containerTypeName.Value = 'CTcVnContainer_Vector_Vector_TcVnDMatch' THEN
	Serialize_ContainerType_Vector_TcVnDMatch(Serializer, activeData);
ELSIF containerTypeName.Value = 'CTcVnContainer_String_SINT' THEN
	Serialize_ContainerType_String_SINT(Serializer, activeData);
ELSIF containerTypeName.Value = 'CTcVnContainer_Vector_String_SINT' THEN
	Serialize_ContainerType_Vector_String_SINT(Serializer, activeData);
		
END_IF
// Serializer.EndArray();
Serializer.EndObject();]]></ST>
      </Implementation>
    </Method>
