    <Method Name="Serialize_ContainerType_Vector_ITcVnImage" Id="{90f81a39-4834-0e76-1bc7-75a4fcf9850e}" FolderPath="Customize\Private\">
      <Declaration><![CDATA[METHOD PRIVATE Serialize_ContainerType_Vector_ITcVnImage
VAR_INPUT
	Serializer : I_Serializer;
	TargetContainer : ITcVnContainer;
END_VAR
VAR
	hr : HRESULT;
	_value : _ITcVnImage;
	elementCount : ULINT;
	i : ULINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TargetContainer.GetElementNum(elementCount);
Serializer.StartArray();

FOR i := 0 TO elementCount - 1 DO 
	
	hr := F_VN_GetAt_ITcVnImage(TargetContainer, _value.Value, i, S_OK);
	
	IF SUCCEEDED(hr) THEN
		Serializer.AddObject(_value);
	ELSE
		Serializer.AddNull();
	END_IF

END_FOR

IF _value.Value <> 0 THEN
	_value.Value.TcRelease();
END_IF

Serializer.EndArray();]]></ST>
      </Implementation>
    </Method>
