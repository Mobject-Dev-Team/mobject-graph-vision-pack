    <Method Name="Serialize_ContainerType_String_SINT" Id="{327b5f94-51dd-08c5-2148-70dbfb309bf5}" FolderPath="Customize\Private\">
      <Declaration><![CDATA[METHOD PRIVATE Serialize_ContainerType_String_SINT
VAR_INPUT
	Serializer : I_Serializer;
	TargetContainer : ITcVnContainer;
END_VAR
VAR
	hr : HRESULT;
	_value : _STRING('');
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[hr := F_VN_ExportContainer_String(TargetContainer, _value.Value, SIZEOF(_value.Value), S_OK);
Serializer.StartArray();

IF SUCCEEDED(hr) THEN
	Serializer.AddObject(_value);
ELSE
	Serializer.AddNull();
END_IF

Serializer.EndArray();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Serialize_ContainerType_Vector_DINT" Id="{21396846-aafc-043b-04c3-1164cfdda6b7}" FolderPath="Customize\Private\">
      <Declaration><![CDATA[METHOD PRIVATE Serialize_ContainerType_Vector_DINT
VAR_INPUT
	Serializer : I_Serializer;
	TargetContainer : ITcVnContainer;
END_VAR
VAR
	hr : HRESULT;
	_value : _DINT(0);
	elementCount : ULINT;
	i : ULINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TargetContainer.GetElementNum(elementCount);
Serializer.StartArray();

FOR i := 0 TO elementCount - 1 DO 
	
	hr := F_VN_GetAt_DINT(TargetContainer, _value.Value, i, S_OK);
	
	IF SUCCEEDED(hr) THEN
		Serializer.AddObject(_value);
	ELSE
		Serializer.AddNull();
	END_IF
	
END_FOR

Serializer.EndArray();]]></ST>
      </Implementation>
    </Method>
