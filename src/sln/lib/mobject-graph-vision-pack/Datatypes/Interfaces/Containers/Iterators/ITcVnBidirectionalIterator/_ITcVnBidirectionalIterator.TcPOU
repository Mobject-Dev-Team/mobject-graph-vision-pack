        </Implementation>
      </Get>
    </Property>
    <Property Name="IsValid" Id="{1d127891-191b-0c31-1c87-e19954f1bc2c}">
      <Declaration><![CDATA[PROPERTY PUBLIC IsValid : BOOL]]></Declaration>
      <Get Name="Get" Id="{9c547f0c-b6db-0cad-1245-7c4fefbbfe7c}">
