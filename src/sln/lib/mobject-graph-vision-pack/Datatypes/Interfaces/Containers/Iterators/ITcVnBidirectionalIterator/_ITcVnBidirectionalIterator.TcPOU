  <POU Name="_ITcVnBidirectionalIterator" Id="{34fa7641-846d-0f2d-14a7-eb5fd9e7b60b}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'linkalways'} 
{attribute 'no_explicit_call' := 'This FB is a CLASS and must be accessed using methods or properties'}
{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK _ITcVnBidirectionalIterator EXTENDS InterfaceDatatypeBase IMPLEMENTS I_InterfaceDatatype_ITcVnBidirectionalIterator
VAR
	localData : ITcVnBidirectionalIterator;
	activeData : REFERENCE TO ITcVnBidirectionalIterator REF= localData;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Core" Id="{3c3e4c0d-3d4c-0c92-02bb-1d1f91afbf8f}" />
