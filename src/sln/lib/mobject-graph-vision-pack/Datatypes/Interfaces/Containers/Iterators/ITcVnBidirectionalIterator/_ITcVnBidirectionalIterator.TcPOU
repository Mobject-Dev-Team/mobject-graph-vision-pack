      </Implementation>
    </Method>
    <Method Name="SerializeWith" Id="{8e9329da-eab9-00d9-21b8-cda7ba62f2b8}" FolderPath="Customize\">
      <Declaration><![CDATA[METHOD PUBLIC SerializeWith
