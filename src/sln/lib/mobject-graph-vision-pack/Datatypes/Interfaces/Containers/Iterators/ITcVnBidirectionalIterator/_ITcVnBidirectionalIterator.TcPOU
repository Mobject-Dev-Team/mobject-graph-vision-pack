    <Method Name="TryCheckIfBegin" Id="{919bc0d9-ee18-0c51-1821-35727836149d}">
      <Declaration><![CDATA[METHOD PUBLIC TryCheckIfBegin : BOOL
VAR_INPUT
	Result : REFERENCE TO BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Result := FALSE;

IF NOT IsValid THEN
	RETURN;
END_IF

IF activeData.CheckIfBegin() = S_OK THEN
    Result := TRUE;
END_IF

TryCheckIfBegin := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="TryCheckIfEnd" Id="{474b55af-afd8-084a-0c9c-49eb2d87ce2d}">
