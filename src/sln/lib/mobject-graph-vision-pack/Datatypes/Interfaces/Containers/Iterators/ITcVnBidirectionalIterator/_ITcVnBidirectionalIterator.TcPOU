END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Result := FALSE;

IF NOT IsValid THEN
	RETURN;
END_IF

IF activeData.CheckIfEnd() = S_OK THEN
    Result := TRUE;
END_IF

TryCheckIfEnd := TRUE;
]]></ST>
      </Implementation>
    </Method>
