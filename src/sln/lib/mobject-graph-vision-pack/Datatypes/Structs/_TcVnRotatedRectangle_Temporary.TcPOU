    <Method Name="SetMemberReference" Id="{eeb7b307-8e6c-0591-0360-28da41cba35f}" FolderPath="Customize\Protected\">
      <Declaration><![CDATA[METHOD PROTECTED SetMemberReference
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_fCenter_X.MakeReferenceTo(activeData.aCenter[0]);
_fCenter_Y.MakeReferenceTo(activeData.aCenter[1]);
_fSize_Width.MakeReferenceTo(activeData.stSize.fWidth);
_fSize_Height.MakeReferenceTo(activeData.stSize.fHeight);
_fAngle.MakeReferenceTo(activeData.fAngle);
]]></ST>
      </Implementation>
    </Method>
