    _fCenter_Y : _REAL(0.0);
    _fSize_Width : _REAL(0.0);
    _fSize_Height: _REAL(0.0);
    _fAngle : _REAL(localdata.fAngle);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
