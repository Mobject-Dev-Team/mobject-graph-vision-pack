FUNCTION_BLOCK Node_F_VN_AnalyzeBarcodeWalsh EXTENDS VisionNode
VAR
    ipBarcodeImage : _ITcVnImage;
    stParams : _TcVnParamsWalshBarcodeDetection;
    hrPrev : _HRESULT(S_OK);
    hresult : _HRESULT(S_OK);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Constructor" Id="{d5743ad7-1f0e-4828-9f02-042bbf5aacce}" />
    <Method Name="Clone" Id="{44e29a3e-edeb-4358-b81e-35370ba4e559}">
      <Declaration><![CDATA[METHOD PUBLIC Clone : I_Node
VAR
    pNode : POINTER TO Node_F_VN_AnalyzeBarcodeWalsh;
