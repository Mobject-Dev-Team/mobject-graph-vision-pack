      </Implementation>
    </Method>
    <Method Name="FB_init" Id="{69f15610-6671-4cf1-a5e6-bc8f10f5b0c1}" FolderPath="Constructor\">
      <Declaration><![CDATA[METHOD FB_init : BOOL
VAR_INPUT
    bInitRetains : BOOL;
