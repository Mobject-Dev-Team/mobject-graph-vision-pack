    <Method Name="OnExecute" Id="{eb7e3c59-9659-4ff7-ae6e-b5e2dc566e61}">
      <Declaration><![CDATA[METHOD PROTECTED OnExecute
]]></Declaration>
      <Implementation>
        <ST><![CDATA[hresult.Value := F_VN_AnalyzeBarcodeWalsh(
