<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.19">
  <POU Name="Node_F_VN_ConvertContainerType" Id="{5f20063b-0fde-48b7-b280-ab346932d891}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'linkalways'}
{attribute 'no_explicit_call' := 'This FB is a CLASS and must be accessed using methods or properties'}
{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK Node_F_VN_ConvertContainerType EXTENDS VisionNode
VAR
    ipSrcContainer : _ITcVnContainer;
    ipDestContainer : _ITcVnContainer;
    nDestTypeGuid : _GUID();
    hrPrev : _HRESULT(S_OK);
    hresult : _HRESULT(S_OK);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Constructor" Id="{05d94737-5214-4c20-8116-2e9561e3ada6}" />
    <Method Name="Clone" Id="{0613d17e-343e-4ef7-a077-2844918c1730}">
      <Declaration><![CDATA[METHOD PUBLIC Clone : I_Node
VAR
    pNode : POINTER TO Node_F_VN_ConvertContainerType;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[pNode := __NEW(Node_F_VN_ConvertContainerType);
Clone := pNode^;]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_init" Id="{b222ebe6-f1bb-46fd-9655-135e399c942e}" FolderPath="Constructor\">
      <Declaration><![CDATA[METHOD FB_init : BOOL
VAR_INPUT
    bInitRetains : BOOL;
    bInCopyCode : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[AddInput('ipSrcContainer', ipSrcContainer);
AddParameter('nDestTypeGuid', nDestTypeGuid);
AddInput('hrPrev', hrPrev);
AddOutput('ipDestContainer', ipDestContainer);
AddOutput('hresult', hresult);]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnExecute" Id="{10f9e232-f192-4244-bae6-9e86d333c795}">
      <Declaration><![CDATA[METHOD PROTECTED OnExecute
]]></Declaration>
      <Implementation>
        <ST><![CDATA[hresult.Value := F_VN_ConvertContainerType(
    ipSrcContainer := ipSrcContainer.Value,
    ipDestContainer := ipDestContainer.Value,
    nDestTypeGuid := nDestTypeGuid.Value,
    hrPrev := hrPrev.Value);]]></ST>
      </Implementation>
    </Method>
    <Method Name="PreExecutionCheck" Id="{582e1282-4b69-41d5-b475-fa9b68477de9}">
      <Declaration><![CDATA[METHOD PUBLIC PreExecutionCheck
VAR_INPUT
    Check : I_PreExecutionChecks;
END_VAR
VAR
    srcTypeGuid : GUID;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Check.IsTrue(ipSrcContainer.IsValid, 'ipSrcContainer must be a valid container');
IF ipSrcContainer.IsValid THEN
    ipSrcContainer.Value.GetTypeGuid(srcTypeGuid);
END_IF
Check.IsTrue(GetContainerTypeDimensions(srcTypeGuid) > 0, 'ipSrcContainer must hold arithmetic, TcVnPoint or TcVnVector elements');
Check.IsTrue(GetContainerTypeDimensions(nDestTypeGuid.Value) > 0, 'nDestTypeGuid must be an arithmetic, TcVnPoint or TcVnVector container type');]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>