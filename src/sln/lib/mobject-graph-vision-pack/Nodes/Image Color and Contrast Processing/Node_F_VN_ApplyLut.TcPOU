<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.19">
  <POU Name="Node_F_VN_ApplyLut" Id="{eaa0fc68-ded7-49d7-8448-7926173abe7c}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'linkalways'}
{attribute 'no_explicit_call' := 'This FB is a CLASS and must be accessed using methods or properties'}
{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK Node_F_VN_ApplyLut EXTENDS VisionNode
VAR
    ipSrcImage : _ITcVnImage;
    ipDestImage : _ITcVnImage;
    ipLut : _ITcVnContainer;
    hrPrev : _HRESULT(S_OK);
    hresult : _HRESULT(S_OK);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Constructor" Id="{19db8212-1973-424c-ab1f-fabff017ff6e}" />
    <Method Name="Clone" Id="{feb36d8d-4350-4637-a0ec-b2abf6753dc6}">
      <Declaration><![CDATA[METHOD PUBLIC Clone : I_Node
VAR
    pNode : POINTER TO Node_F_VN_ApplyLut;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[pNode := __NEW(Node_F_VN_ApplyLut);
Clone := pNode^;]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_init" Id="{9c40f3e9-11be-4f25-8880-05a80836e7c0}" FolderPath="Constructor\">
      <Declaration><![CDATA[METHOD FB_init : BOOL
VAR_INPUT
    bInitRetains : BOOL;
    bInCopyCode : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[AddInput('ipSrcImage', ipSrcImage);
AddInput('ipLut', ipLut);
AddInput('hrPrev', hrPrev);
AddOutput('ipDestImage', ipDestImage);
AddOutput('hresult', hresult);]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnExecute" Id="{d5bf4b5c-b53b-4806-aac1-83b3a768b124}">
      <Declaration><![CDATA[METHOD PROTECTED OnExecute
]]></Declaration>
      <Implementation>
        <ST><![CDATA[hresult.Value := F_VN_ApplyLut(
    ipSrcImage := ipSrcImage.Value,
    ipDestImage := ipDestImage.Value,
    ipLut := ipLut.Value,
    hrPrev := hrPrev.Value);]]></ST>
      </Implementation>
    </Method>
    <Method Name="PreExecutionCheck" Id="{0e646201-8660-475f-b7fb-827078d49d4f}">
      <Declaration><![CDATA[METHOD PUBLIC PreExecutionCheck
VAR_INPUT
    Check : I_PreExecutionChecks;
END_VAR
VAR
    elementNum : ULINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Check.IsTrue(ipSrcImage.IsValid, 'ipSrcImage must contain an image');
Check.IsTrue(ipSrcImage.HasChannelCount(1) OR ipSrcImage.HasChannelCount(2) OR ipSrcImage.HasChannelCount(3) OR ipSrcImage.HasChannelCount(4), 'ipSrcImage must have 1 to 4 channels');
Check.IsTrue(ipSrcImage.IsElementType(ETcVnElementType.TCVN_ET_SINT) OR
             ipSrcImage.IsElementType(ETcVnElementType.TCVN_ET_USINT) OR
             ipSrcImage.IsElementType(ETcVnElementType.TCVN_ET_INT) OR
             ipSrcImage.IsElementType(ETcVnElementType.TCVN_ET_UINT), 'ipSrcImage must contain SINT, USINT, INT or UINT elements');
Check.IsTrue(ipLut.IsValid, 'ipLut must be a valid container');

ipLut.TryGetElementNum(elementNum);
IF ipSrcImage.IsPixelDepth(8) THEN
    Check.IsTrue(elementNum = 256, 'ipLut must contain 256 elements for an 8 bit image');
ELSIF ipSrcImage.IsPixelDepth(16) THEN
    Check.IsTrue(elementNum = 65536, 'ipLut must contain 65536 elements for a 16 bit image');
END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>