    hresult : _HRESULT(S_OK);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Constructor" Id="{52f43bc7-b9c1-0658-1f41-ca7d53fdf788}" />
    <Method Name="Clone" Id="{d939e7ee-9ebc-0aab-1742-c067b903492e}">
      <Declaration><![CDATA[METHOD PUBLIC  Clone : I_Node
