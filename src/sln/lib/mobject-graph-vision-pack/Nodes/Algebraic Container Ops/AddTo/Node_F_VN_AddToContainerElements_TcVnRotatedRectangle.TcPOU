    <Method Name="OnExecute" Id="{d2f24ab2-d233-0ec1-2362-95ecadcba636}">
      <Declaration><![CDATA[METHOD PROTECTED OnExecute]]></Declaration>
      <Implementation>
        <ST><![CDATA[hresult.Value := F_VN_AddToContainerElements_TcVnRotatedRectangle(
