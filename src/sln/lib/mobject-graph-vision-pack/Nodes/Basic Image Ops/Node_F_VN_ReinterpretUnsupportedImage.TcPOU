<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.19">
  <POU Name="Node_F_VN_ReinterpretUnsupportedImage" Id="{70f680ea-5804-490e-ae34-ca38a2e5e99e}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'linkalways'}
{attribute 'no_explicit_call' := 'This FB is a CLASS and must be accessed using methods or properties'}
{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK Node_F_VN_ReinterpretUnsupportedImage EXTENDS VisionNode
VAR
    ipImage : _ITcVnImage;
    ePixelType : _ETcVnElementType(ETcVnElementType.TCVN_ET_USINT);
    hrPrev : _HRESULT(S_OK);
    hresult : _HRESULT(S_OK);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Constructor" Id="{62ce1d5c-2893-48f7-9407-aa3b704eb0d7}" />
    <Method Name="Clone" Id="{18e0bc5d-f152-491b-b7f6-72f4a8259d9f}">
      <Declaration><![CDATA[METHOD PUBLIC Clone : I_Node
VAR
    pNode : POINTER TO Node_F_VN_ReinterpretUnsupportedImage;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[pNode := __NEW(Node_F_VN_ReinterpretUnsupportedImage);
Clone := pNode^;]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_init" Id="{76d1772c-be69-476a-9159-2ff596a25b54}" FolderPath="Constructor\">
      <Declaration><![CDATA[METHOD FB_init : BOOL
VAR_INPUT
    bInitRetains : BOOL;
    bInCopyCode : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[AddInput('ipImage', ipImage);
AddParameter('ePixelType', ePixelType);
AddInput('hrPrev', hrPrev);
AddOutput('ipImage', ipImage);
AddOutput('hresult', hresult);]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnExecute" Id="{279ba793-4f0d-4835-980b-384333a6cc59}">
      <Declaration><![CDATA[METHOD PROTECTED OnExecute
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Reinterpreting the image itself is the point of this call, so it acts on the connected image.
hresult.Value := F_VN_ReinterpretUnsupportedImage(
    ipImage := ipImage.Value,
    ePixelType := ePixelType.Value,
    hrPrev := hrPrev.Value);]]></ST>
      </Implementation>
    </Method>
    <Method Name="PreExecutionCheck" Id="{b3fd0d05-766a-4c52-8530-58430c1b0f3a}">
      <Declaration><![CDATA[METHOD PUBLIC PreExecutionCheck
VAR_INPUT
    Check : I_PreExecutionChecks;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Check.IsTrue(ipImage.IsValid, 'ipImage must contain an image');
Check.IsTrue(ePixelType.Value <> ETcVnElementType.TCVN_ET_SAME_AS_SOURCE, 'ePixelType must name a pixel element type');]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>