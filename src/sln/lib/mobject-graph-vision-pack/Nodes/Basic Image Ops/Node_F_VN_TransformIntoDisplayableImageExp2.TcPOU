<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.19">
  <POU Name="Node_F_VN_TransformIntoDisplayableImageExp2" Id="{36f7be24-4e41-49cd-aa46-ad55d684f65e}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'linkalways'}
{attribute 'no_explicit_call' := 'This FB is a CLASS and must be accessed using methods or properties'}
{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK Node_F_VN_TransformIntoDisplayableImageExp2 EXTENDS VisionNode
VAR
    ipSrcImage : _ITcVnImage;
    ipDestImage : _ITcVnDisplayableImage;
    bAllowDeepCopy : _BOOL(FALSE);
    nTimestamp : _LINT(0);
    hrPrev : _HRESULT(S_OK);
    hresult : _HRESULT(S_OK);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Constructor" Id="{40591ef4-506c-4b9d-ac5f-d3b4b8cfa2b4}" />
    <Method Name="Clone" Id="{f906662b-1ecd-404f-a9cd-8fb853f3f4d9}">
      <Declaration><![CDATA[METHOD PUBLIC Clone : I_Node
VAR
    pNode : POINTER TO Node_F_VN_TransformIntoDisplayableImageExp2;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[pNode := __NEW(Node_F_VN_TransformIntoDisplayableImageExp2);
Clone := pNode^;]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_init" Id="{49dcad6f-9956-4cf3-92d3-4f70884f9055}" FolderPath="Constructor\">
      <Declaration><![CDATA[METHOD FB_init : BOOL
VAR_INPUT
    bInitRetains : BOOL;
    bInCopyCode : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[AddInput('ipSrcImage', ipSrcImage);
AddParameter('bAllowDeepCopy', bAllowDeepCopy);
AddParameter('nTimestamp', nTimestamp);
AddInput('hrPrev', hrPrev);
AddOutput('ipDestImage', ipDestImage);
AddOutput('hresult', hresult);]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnExecute" Id="{ccc1d886-8d68-4065-8ca8-d1ac52e0d737}">
      <Declaration><![CDATA[METHOD PROTECTED OnExecute
]]></Declaration>
      <Implementation>
        <ST><![CDATA[hresult.Value := F_VN_TransformIntoDisplayableImageExp2(
    ipSrcImage := ipSrcImage.Value,
    ipDestImage := ipDestImage.Value,
    bAllowDeepCopy := bAllowDeepCopy.Value,
    nTimestamp := nTimestamp.Value,
    hrPrev := hrPrev.Value);]]></ST>
      </Implementation>
    </Method>
    <Method Name="PreExecutionCheck" Id="{0d203290-9227-412e-b5a5-90feee246843}">
      <Declaration><![CDATA[METHOD PUBLIC PreExecutionCheck
VAR_INPUT
    Check : I_PreExecutionChecks;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Check.IsTrue(ipSrcImage.IsValid, 'ipSrcImage must contain an image');]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>