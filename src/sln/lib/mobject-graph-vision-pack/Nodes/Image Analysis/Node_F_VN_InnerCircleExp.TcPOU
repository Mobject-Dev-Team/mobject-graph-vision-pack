<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.19">
  <POU Name="Node_F_VN_InnerCircleExp" Id="{9a994708-fb0d-4833-9cc7-fdf209f1db92}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'linkalways'}
{attribute 'no_explicit_call' := 'This FB is a CLASS and must be accessed using methods or properties'}
{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK Node_F_VN_InnerCircleExp EXTENDS VisionNode
VAR
    ipSrcImage : _ITcVnImage;
    fRadius : _LREAL(0.0);
    aCenter : _TcVnPoint2_REAL;
    eDistanceType : _ETcVnDistanceType(ETcVnDistanceType.TCVN_DT_L2);
    eMaskSize : _ETcVnDistanceTransformationMask(ETcVnDistanceTransformationMask.TCVN_DTM_5);
    hrPrev : _HRESULT(S_OK);
    hresult : _HRESULT(S_OK);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Constructor" Id="{9680acc0-d5f0-4cba-991c-c9cc6fe6a1e1}" />
    <Method Name="Clone" Id="{a97536f8-4c73-4fe6-b283-d351af486bd3}">
      <Declaration><![CDATA[METHOD PUBLIC Clone : I_Node
VAR
    pNode : POINTER TO Node_F_VN_InnerCircleExp;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[pNode := __NEW(Node_F_VN_InnerCircleExp);
Clone := pNode^;]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_init" Id="{dee5f4b5-4070-41dd-9831-565ec2734d4b}" FolderPath="Constructor\">
      <Declaration><![CDATA[METHOD FB_init : BOOL
VAR_INPUT
    bInitRetains : BOOL;
    bInCopyCode : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[AddInput('ipSrcImage', ipSrcImage);
AddParameter('eDistanceType', eDistanceType);
AddParameter('eMaskSize', eMaskSize);
AddInput('hrPrev', hrPrev);
AddOutput('fRadius', fRadius);
AddOutput('aCenter', aCenter);
AddOutput('hresult', hresult);]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnExecute" Id="{630d234b-2fea-4432-827b-af566304a5e3}">
      <Declaration><![CDATA[METHOD PROTECTED OnExecute
]]></Declaration>
      <Implementation>
        <ST><![CDATA[hresult.Value := F_VN_InnerCircleExp(
    ipSrcImage := ipSrcImage.Value,
    fRadius := fRadius.Value,
    aCenter := aCenter.Value,
    eDistanceType := eDistanceType.Value,
    eMaskSize := eMaskSize.Value,
    hrPrev := hrPrev.Value);]]></ST>
      </Implementation>
    </Method>
    <Method Name="PreExecutionCheck" Id="{e76cf871-fd6d-4fcd-b44b-88c7cb679f77}">
      <Declaration><![CDATA[METHOD PUBLIC PreExecutionCheck
VAR_INPUT
    Check : I_PreExecutionChecks;
END_VAR
VAR
    distanceTypeIsValid : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Check.IsTrue(ipSrcImage.IsValid, 'ipSrcImage must contain an image');
Check.IsTrue(ipSrcImage.HasChannelCount(1), 'ipSrcImage must have 1 channel');
Check.IsTrue(ipSrcImage.IsElementType(ETcVnElementType.TCVN_ET_USINT), 'ipSrcImage must contain USINT elements');

CASE eDistanceType.Value OF
    ETcVnDistanceType.TCVN_DT_L1,
    ETcVnDistanceType.TCVN_DT_L2,
    ETcVnDistanceType.TCVN_DT_C :
        distanceTypeIsValid := TRUE;
END_CASE
Check.IsTrue(distanceTypeIsValid, 'eDistanceType value is unsupported');]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>