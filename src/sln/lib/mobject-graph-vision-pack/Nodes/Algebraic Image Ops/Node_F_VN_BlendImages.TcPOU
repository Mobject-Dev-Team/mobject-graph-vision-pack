<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.19">
  <POU Name="Node_F_VN_BlendImages" Id="{369b89ff-0893-4945-8338-d01e69981ef6}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'linkalways'}
{attribute 'no_explicit_call' := 'This FB is a CLASS and must be accessed using methods or properties'}
{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK Node_F_VN_BlendImages EXTENDS VisionNode
VAR
    ipSrcImage1 : _ITcVnImage;
    ipSrcImage2 : _ITcVnImage;
    ipWeights1 : _ITcVnImage;
    ipWeights2 : _ITcVnImage;
    ipDestImage : _ITcVnImage;
    hrPrev : _HRESULT(S_OK);
    hresult : _HRESULT(S_OK);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Constructor" Id="{d6409cba-f297-44db-8714-9e5f7498c477}" />
    <Method Name="Clone" Id="{ca5e7b7b-7716-4294-b883-625136299308}">
      <Declaration><![CDATA[METHOD PUBLIC Clone : I_Node
VAR
    pNode : POINTER TO Node_F_VN_BlendImages;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[pNode := __NEW(Node_F_VN_BlendImages);
Clone := pNode^;]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_init" Id="{67a241de-4707-4dda-bc37-12f0f70d5f08}" FolderPath="Constructor\">
      <Declaration><![CDATA[METHOD FB_init : BOOL
VAR_INPUT
    bInitRetains : BOOL;
    bInCopyCode : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[AddInput('ipSrcImage1', ipSrcImage1);
AddInput('ipSrcImage2', ipSrcImage2);
AddInput('ipWeights1', ipWeights1);
AddInput('ipWeights2', ipWeights2);
AddInput('hrPrev', hrPrev);
AddOutput('ipDestImage', ipDestImage);
AddOutput('hresult', hresult);]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnExecute" Id="{39fa9873-4295-4cb9-8fe6-830db51426a6}">
      <Declaration><![CDATA[METHOD PROTECTED OnExecute
]]></Declaration>
      <Implementation>
        <ST><![CDATA[hresult.Value := F_VN_BlendImages(
    ipSrcImage1 := ipSrcImage1.Value,
    ipSrcImage2 := ipSrcImage2.Value,
    ipWeights1 := ipWeights1.Value,
    ipWeights2 := ipWeights2.Value,
    ipDestImage := ipDestImage.Value,
    hrPrev := hrPrev.Value);]]></ST>
      </Implementation>
    </Method>
    <Method Name="PreExecutionCheck" Id="{4ee7a610-7de1-407a-b49f-0c86c1d6c1b6}">
      <Declaration><![CDATA[METHOD PUBLIC PreExecutionCheck
VAR_INPUT
    Check : I_PreExecutionChecks;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Check.IsTrue(ipSrcImage1.IsValid, 'ipSrcImage1 must contain an image');
Check.IsTrue(ipSrcImage1.IsElementType(ETcVnElementType.TCVN_ET_USINT) OR ipSrcImage1.IsElementType(ETcVnElementType.TCVN_ET_REAL), 'ipSrcImage1 must contain USINT or REAL elements');
Check.IsTrue(ipSrcImage2.IsValid, 'ipSrcImage2 must contain an image');
Check.IsTrue(ImagesHaveMatchingPixelFormats(ipSrcImage1.Value, ipSrcImage2.Value), 'ipSrcImage1 and ipSrcImage2 must have matching pixel formats');
Check.IsTrue(IsImage1SizeEqualToImage2Size(ipSrcImage1.Value, ipSrcImage2.Value), 'ipSrcImage1 and ipSrcImage2 must have matching dimensions');
Check.IsTrue(ipWeights1.IsValid, 'ipWeights1 must contain an image');
Check.IsTrue(ipWeights1.HasChannelCount(1) AND ipWeights1.IsElementType(ETcVnElementType.TCVN_ET_REAL), 'ipWeights1 must have 1 channel of REAL elements');
Check.IsTrue(IsImage1SizeEqualToImage2Size(ipSrcImage1.Value, ipWeights1.Value), 'ipWeights1 must have the same dimensions as ipSrcImage1');
Check.IsTrue(ipWeights2.IsValid, 'ipWeights2 must contain an image');
Check.IsTrue(ipWeights2.HasChannelCount(1) AND ipWeights2.IsElementType(ETcVnElementType.TCVN_ET_REAL), 'ipWeights2 must have 1 channel of REAL elements');
Check.IsTrue(IsImage1SizeEqualToImage2Size(ipSrcImage1.Value, ipWeights2.Value), 'ipWeights2 must have the same dimensions as ipSrcImage1');]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>