<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.25">
  <POU Name="_VisionApi5102_Datatypes_TestSuite" Id="{b09acb0e-4a62-4dac-b628-f0cf81849c42}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK _VisionApi5102_Datatypes_TestSuite EXTENDS TcUnit.FB_TestSuite
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[TestNewDatatypeRegistration();
TestNewEnumRoundTrips();
TestUpdatedEnumsAndLegacyLabel();
TestEnumStorageAndReference();
TestParameterDefaults();
TestNestedReferences();
TestCloneCopiesActiveValue();
TestLegacyBriskMember();]]></ST>
    </Implementation>
    <Method Name="TestNewDatatypeRegistration" Id="{ea27b8af-c7f1-460a-bfb8-2ca77ae8f1cf}">
      <Declaration><![CDATA[METHOD PRIVATE TestNewDatatypeRegistration
VAR
    datatypes : Datatypes;
    pack : VisionDatatypePack;
    enumeration : I_EnumDatatype;
    structure : I_StructuredDatatype;
    aliasType : I_AliasDatatype;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('TestNewDatatypeRegistration');

pack.RegisterWithDatatypes(datatypes);
AssertTrue(datatypes.TryGetEnumByIdentifier('ETcVnComparisonOperator', enumeration), 'ETcVnComparisonOperator must be registered');
AssertTrue(datatypes.TryGetEnumByIdentifier('ETcVnDetectBarcodesWalshOptions', enumeration), 'ETcVnDetectBarcodesWalshOptions must be registered');
AssertTrue(datatypes.TryGetEnumByIdentifier('ETcVnDetectPatternPointsOptions', enumeration), 'ETcVnDetectPatternPointsOptions must be registered');
AssertTrue(datatypes.TryGetEnumByIdentifier('ETcVnDotCodeOptions', enumeration), 'ETcVnDotCodeOptions must be registered');
AssertTrue(datatypes.TryGetEnumByIdentifier('ETcVnEdgeSelection', enumeration), 'ETcVnEdgeSelection must be registered');
AssertTrue(datatypes.TryGetEnumByIdentifier('ETcVnFindRoisMethod', enumeration), 'ETcVnFindRoisMethod must be registered');
AssertTrue(datatypes.TryGetEnumByIdentifier('ETcVnJpegSampling', enumeration), 'ETcVnJpegSampling must be registered');
AssertTrue(datatypes.TryGetEnumByIdentifier('ETcVnMergeRegionsOptions', enumeration), 'ETcVnMergeRegionsOptions must be registered');
AssertTrue(datatypes.TryGetEnumByIdentifier('ETcVnPolarizedImageInterpolation', enumeration), 'ETcVnPolarizedImageInterpolation must be registered');
AssertTrue(datatypes.TryGetEnumByIdentifier('ETcVnSalientFeaturesMethod', enumeration), 'ETcVnSalientFeaturesMethod must be registered');
AssertTrue(datatypes.TryGetStructureByIdentifier('GVCP_ADDRESS_VALUE_PAIR', structure), 'GVCP_ADDRESS_VALUE_PAIR must be registered');
AssertTrue(datatypes.TryGetStructureByIdentifier('TcVnSize2_DINT', structure), 'TcVnSize2_DINT must be registered');
AssertTrue(datatypes.TryGetStructureByIdentifier('TcVnParamsFindRois', structure), 'TcVnParamsFindRois must be registered');
AssertTrue(datatypes.TryGetStructureByIdentifier('TcVnParamsWalshBarcodeDetection', structure), 'TcVnParamsWalshBarcodeDetection must be registered');
AssertTrue(datatypes.TryGetAliasByIdentifier('GVCP_REGISTER_VALUE', aliasType), 'Register-value alias must be registered');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="TestNewEnumRoundTrips" Id="{62f1ee65-7dc4-4b09-b1c3-b7c950956b2f}">
      <Declaration><![CDATA[METHOD PRIVATE TestNewEnumRoundTrips
VAR
    e0 : _ETcVnComparisonOperator(ETcVnComparisonOperator.TCVN_CO_GREATER);
    e1 : _ETcVnDetectBarcodesWalshOptions(ETcVnDetectBarcodesWalshOptions.TCVN_DBWO_ALL_DIRECTIONS);
    e2 : _ETcVnDetectPatternPointsOptions(ETcVnDetectPatternPointsOptions.TCVN_DPPO_CLUSTERING);
    e3 : _ETcVnDotCodeOptions(ETcVnDotCodeOptions.TCVN_DCO_INVERTED_COLOR);
    e4 : _ETcVnEdgeSelection(ETcVnEdgeSelection.TCVN_ES_ANY);
    e5 : _ETcVnFindRoisMethod(ETcVnFindRoisMethod.TCVN_FRM_CONNECTEDCOMPONENTS);
    e6 : _ETcVnJpegSampling(ETcVnJpegSampling.TCVN_JS_410);
    e7 : _ETcVnMergeRegionsOptions(ETcVnMergeRegionsOptions.TCVN_MRO_UPRIGHTBOUNDINGRECT);
    e8 : _ETcVnPolarizedImageInterpolation(ETcVnPolarizedImageInterpolation.TCVN_PII_LANCZOS4);
    e9 : _ETcVnSalientFeaturesMethod(ETcVnSalientFeaturesMethod.TCVN_SFM_SOBEL);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('TestNewEnumRoundTrips');

AssertEnumRoundTrip(e0, '"TCVN_CO_LESS"', '"TCVN_CO_LESS"');
AssertEnumRoundTrip(e1, '"TCVN_DBWO_HORIZONTAL"', '"TCVN_DBWO_HORIZONTAL"');
AssertEnumRoundTrip(e2, '"TCVN_DPPO_SYMMETRIC"', '"TCVN_DPPO_SYMMETRIC"');
AssertEnumRoundTrip(e3, '"TCVN_DCO_DEFAULT"', '"TCVN_DCO_DEFAULT"');
AssertEnumRoundTrip(e4, '"TCVN_ES_RISING"', '"TCVN_ES_RISING"');
AssertEnumRoundTrip(e5, '"TCVN_FRM_GRID"', '"TCVN_FRM_GRID"');
AssertEnumRoundTrip(e6, '"TCVN_JS_444"', '"TCVN_JS_444"');
AssertEnumRoundTrip(e7, '"TCVN_MRO_UPRIGHTBOUNDINGRECT"', '"TCVN_MRO_UPRIGHTBOUNDINGRECT"');
AssertEnumRoundTrip(e8, '"TCVN_PII_NONE"', '"TCVN_PII_NONE"');
AssertEnumRoundTrip(e9, '"TCVN_SFM_WALSH_CODE"', '"TCVN_SFM_WALSH_CODE"');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="TestUpdatedEnumsAndLegacyLabel" Id="{b7ebfd3a-8c2f-4cf9-bc78-6b4dc2f6931d}">
      <Declaration><![CDATA[METHOD PRIVATE TestUpdatedEnumsAndLegacyLabel
VAR
    e0 : _ETcVnColorSpaceTransform(ETcVnColorSpaceTransform.TCVN_CST_BGR_TO_BGRA);
    e1 : _ETcVnInterpolationType(ETcVnInterpolationType.TCVN_IT_NEAREST_NEIGHBOR);
    e2 : _ETcVnOcrModelType(ETcVnOcrModelType.TCVN_OMT_NUMBERS);
    e3 : _ETcVnOcrOptions(ETcVnOcrOptions.TCVN_OO_NONE);
    e4 : _ETcVnPixelPackMode(ETcVnPixelPackMode.TCVN_PPM_NONE);
    e5 : _ETcVnTimestamp(ETcVnTimestamp.TCVN_TS_IMAGE_COMPLETED);
    distance : _ETcVnDistanceType(ETcVnDistanceType.TCVN_DT_USER);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('TestUpdatedEnumsAndLegacyLabel');

AssertEnumRoundTrip(e0, '"TCVN_CST_RGB_TO_YUV_422_UYVY"', '"TCVN_CST_RGB_TO_YUV_422_UYVY"');
AssertEnumRoundTrip(e1, '"TCVN_IT_NEAREST_NEIGHBOR_EXACT"', '"TCVN_IT_NEAREST_NEIGHBOR_EXACT"');
AssertEnumRoundTrip(e2, '"TCVN_OMT_CNN_NUMBERS_SC_LETTERS"', '"TCVN_OMT_CNN_NUMBERS_SC_LETTERS"');
AssertEnumRoundTrip(e3, '"TCVN_OO_NOVELTY_LEVEL3"', '"TCVN_OO_NOVELTY_LEVEL3"');
AssertEnumRoundTrip(e4, '"TCVN_PPM_MONO14P"', '"TCVN_PPM_MONO14P"');
AssertEnumRoundTrip(e5, '"TCVN_TS_CAMERA"', '"TCVN_TS_CAMERA"');
AssertEnumRoundTrip(distance, '"TCVN_DT_HUBER "', '"TCVN_DT_HUBER"');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="TestEnumStorageAndReference" Id="{7dd8cbeb-b93b-41ff-883e-96ef9504ca47}">
      <Declaration><![CDATA[METHOD PRIVATE TestEnumStorageAndReference
VAR
    comparison : _ETcVnComparisonOperator(ETcVnComparisonOperator.TCVN_CO_LESS);
    dotCode : _ETcVnDotCodeOptions(ETcVnDotCodeOptions.TCVN_DCO_DEFAULT);
    target : ETcVnComparisonOperator := ETcVnComparisonOperator.TCVN_CO_LESS;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('TestEnumStorageAndReference');

AssertTrue(comparison.Size = SIZEOF(INT), 'Comparison operator must retain its INT representation');
AssertTrue(dotCode.Size = SIZEOF(ULINT), 'DotCode options must retain their ULINT representation');
comparison.MakeReferenceTo(target);
comparison.Value := ETcVnComparisonOperator.TCVN_CO_GREATER;
AssertTrue(target = ETcVnComparisonOperator.TCVN_CO_GREATER, 'Enum assignment must update the referenced value');
comparison.ClearReference();
AssertTrue(comparison.Value = ETcVnComparisonOperator.TCVN_CO_LESS, 'Clearing a reference must restore local storage');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="TestParameterDefaults" Id="{cadb57a3-da47-4ced-8ced-d3dc54abd227}">
      <Declaration><![CDATA[METHOD PRIVATE TestParameterDefaults
VAR
    rois : _TcVnParamsFindRois;
    walsh : _TcVnParamsWalshBarcodeDetection;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('TestParameterDefaults');

AssertTrue((rois.Value.stRoiSize.nWidth = 416) AND (rois.Value.stRoiSize.nHeight = 416), 'Default ROI dimensions must be 416 by 416');
AssertTrue(ABS(rois.Value.fMinDensity - 0.2) < 0.000001, 'Default minimum density must be 0.2');
AssertTrue(ABS(rois.Value.fDetectionScaleFactor - 0.25) < 0.000001, 'Default detection scale must be 0.25');
AssertTrue(ABS(rois.Value.fMaxOversizeFraction - 1.0) < 0.000001, 'Default oversize fraction must be 1');
AssertTrue((walsh.Value.nMinArea = -1) AND (walsh.Value.nChannelIndex = -1), 'Walsh automatic-selection sentinels must retain their sign');
AssertTrue(ABS(walsh.Value.fPostProcessingResizeFactor - 0.5) < 0.000001, 'Default Walsh resize factor must be 0.5');
AssertTrue(walsh.Value.eInterpolationType = ETcVnInterpolationType.TCVN_IT_BILINEAR, 'Default Walsh interpolation must be bilinear');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="TestNestedReferences" Id="{f2023def-2b00-4320-995c-7004fb5af940}">
      <Declaration><![CDATA[METHOD PRIVATE TestNestedReferences
VAR
    rois : _TcVnParamsFindRois;
    target : TcVnParamsFindRois;
    pair : _GVCP_ADDRESS_VALUE_PAIR;
    nativePair : GVCP_ADDRESS_VALUE_PAIR;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('TestNestedReferences');

rois.MakeReferenceTo(target);
rois.stRoiSize.nWidth.Value := 128;
AssertTrue(target.stRoiSize.nWidth = 128, 'Nested member writes must reach the referenced struct');
target.stRoiSize.nHeight := 96;
AssertTrue(rois.stRoiSize.nHeight.Value = 96, 'Nested member reads must follow the referenced struct');
rois.ClearReference();
target.stRoiSize.nWidth := 77;
AssertTrue(rois.stRoiSize.nWidth.Value = 416, 'Nested members must rebind to local storage');
pair.MakeReferenceTo(nativePair);
nativePair.nAddress := 16#0100;
nativePair.nValue := 16#12345678;
AssertTrue(pair.nAddress.Value = nativePair.nAddress, 'Register address alias must follow the containing struct');
AssertTrue(pair.nValue.Value = nativePair.nValue, 'Register value alias must follow the containing struct');
pair.ClearReference();

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="TestCloneCopiesActiveValue" Id="{eab7701e-ec8e-4613-903a-4073fdf068e5}">
      <Declaration><![CDATA[METHOD PRIVATE TestCloneCopiesActiveValue
VAR
    rois : _TcVnParamsFindRois;
    target : TcVnParamsFindRois;
    copy : I_Datatype;
    pRois : POINTER TO TcVnParamsFindRois;
    registerValue : _GVCP_REGISTER_VALUE;
    nativeValue : GVCP_REGISTER_VALUE := 16#FFFFFFFF;
    pValue : POINTER TO GVCP_REGISTER_VALUE;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('TestCloneCopiesActiveValue');

rois.MakeReferenceTo(target);
target.stRoiSize.nWidth := 128;
copy := rois.Clone();
AssertTrue(copy <> 0, 'Struct clone must be allocated');
IF copy <> 0 THEN
    pRois := copy.Address;
    target.stRoiSize.nWidth := 256;
    AssertTrue(pRois^.stRoiSize.nWidth = 128, 'Clone must copy active data and remain independent of its source');
    copy.Dispose();
END_IF
rois.ClearReference();
registerValue.MakeReferenceTo(nativeValue);
copy := registerValue.Clone();
AssertTrue(copy <> 0, 'Alias clone must be allocated');
IF copy <> 0 THEN
    pValue := copy.Address;
    nativeValue := 0;
    AssertTrue(pValue^ = 16#FFFFFFFF, 'Alias clone must copy all 32 bits of the active value');
    copy.Dispose();
END_IF
registerValue.ClearReference();

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="TestLegacyBriskMember" Id="{cfe3e7b8-3693-4ee1-9651-11a4436ea363}">
      <Declaration><![CDATA[METHOD PRIVATE TestLegacyBriskMember
VAR
    value : _TcVnParamsBRISK;
    deserializer : JsonDeserializer;
    feedback : DeserializerFeedback;
    serializer : JsonSerializer;
    legacy : STRING := '{"fPatternScale ":2.5}';
    canonical : STRING := '{"fPatternScale":1.25}';
    serialized : STRING(500);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('TestLegacyBriskMember');

deserializer.Reset();
serializer.Reset();
AssertTrue(deserializer.TryLoad(legacy), 'Legacy BRISK JSON must load');
AssertTrue(value.TryDeserializeFrom(deserializer, feedback), 'Legacy BRISK member must remain readable');
AssertTrue(ABS(value.Value.fPatternScale - 2.5) < 0.000001, 'Legacy BRISK scale must be applied');
value.SerializeWith(serializer);
AssertTrue(serializer.TryGetSerializedData(ADR(serialized), SIZEOF(serialized)), 'BRISK data must serialize');
AssertTrue(FIND(serialized, '"fPatternScale":') > 0, 'BRISK serialization must use the corrected member name');
AssertTrue(FIND(serialized, '"fPatternScale ":') = 0, 'BRISK serialization must not emit the legacy member name');
deserializer.Reset();
AssertTrue(deserializer.TryLoad(canonical), 'Canonical BRISK JSON must load');
AssertTrue(value.TryDeserializeFrom(deserializer, feedback), 'Canonical BRISK member must be readable');
AssertTrue(ABS(value.Value.fPatternScale - 1.25) < 0.000001, 'Canonical BRISK scale must be applied');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="AssertEnumRoundTrip" Id="{92f3c31c-8a52-4644-8635-67b136b73970}">
      <Declaration><![CDATA[METHOD PRIVATE AssertEnumRoundTrip
VAR_INPUT
    Datatype : I_Datatype;
    InputJson : STRING;
    ExpectedJson : STRING;
END_VAR
VAR
    deserializer : JsonDeserializer;
    feedback : DeserializerFeedback;
    serializer : JsonSerializer;
    serialized : STRING(500);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[deserializer.Reset();
serializer.Reset();
AssertTrue(deserializer.TryLoad(InputJson), 'Enum JSON must load');
AssertTrue(Datatype.TryDeserializeFrom(deserializer, feedback), 'Enum label must deserialize');
Datatype.SerializeWith(serializer);
AssertTrue(serializer.TryGetSerializedData(ADR(serialized), SIZEOF(serialized)), 'Enum value must serialize');
AssertEquals_STRING(ExpectedJson, serialized, 'Enum round trip must use its canonical label');]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
